{
    "name": "signalk-nemesis",
    "version": "0.4.0",
    "description": "Signal K plugin and webapp that tracks how nearby competitors (your nemesis boats) are sailing relative to you during a race, from AIS and the CYCA race tracker.",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gregw/signalk-nemesis.git"
    },
    "bugs": {
        "url": "https://github.com/gregw/signalk-nemesis/issues"
    },
    "homepage": "https://github.com/gregw/signalk-nemesis#readme",
    "files": [
        "index.js",
        "lib/",
        "public/",
        "README.md",
        "ReleaseNotes.md",
        "LICENSE"
    ],
    "keywords": [
        "signalk-node-server-plugin",
        "signalk-category-utility",
        "signalk-webapp",
        "sailing",
        "racing",
        "regatta",
        "ais",
        "handicap"
    ],
    "signalk-plugin-enabled-by-default": false,
    "signalk": {
        "appIcon": "assets/signalk-nemesis-72x72.png",
        "displayName": "Nemesis Delta"
    },
    "engines": {
        "node": ">=22"
    },
    "author": "gregw@mortbay.com",
    "license": "Apache-2.0",
    "scripts": {
        "test": "node --test test/*.test.js",
        "test:browser": "node --test --test-concurrency=1 test/browser/*.test.js",
        "format": "npx -y prettier@3.3.3 --write index.js \"lib/**/*.js\" \"public/**/*.{js,css,html}\" \"test/**/*.js\"",
        "test:node22": "npx -y -p node@22.22.2 node --test test/*.test.js && npx -y -p node@22.22.2 node --test --test-concurrency=1 test/browser/*.test.js",
        "icon": "node tools/make-icon.js",
        "pack": "mkdir -p dist && npm pack --pack-destination dist"
    },
    "devDependencies": {
        "playwright": "^1.64.1"
    }
}
